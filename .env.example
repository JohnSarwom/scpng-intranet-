# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# SharePoint Migration
# Set to 'true' to use SharePoint for assets, 'false' to use Supabase (default: false)
VITE_USE_SHAREPOINT_ASSETS=false

# Microsoft Graph API
VITE_MICROSOFT_CLIENT_ID=your_client_id_here
VITE_MICROSOFT_TENANT_ID=your_tenant_id_here

# Enable only after both email notice lists have restricted SharePoint permissions.
VITE_ENABLE_EMAIL_NOTICES=false

# Asset QR codes should point to an address phones can open.
# Use your deployed intranet URL in production, or a LAN URL like http://192.168.1.20:8080 for local testing.
VITE_ASSET_QR_BASE_URL=

NODE_ENV=development

# Public URL of the authenticated organization AI gateway. Provider keys belong only in server secrets.
# Cloudflare setup: docs/modules/cloudflare-ai-setup.md (leave blank until deployed and authorized).
VITE_AI_GATEWAY_URL=

# Exposed API delegated scope, e.g. api://<gateway-app-client-id>/AI.Access
VITE_AI_GATEWAY_SCOPE=

# Cloudflare-only pilot: adds Cloudflare to the existing Gemini/Groq fallback service.
# Public URL and delegated scope only. Leave the full AI_GATEWAY values blank for this mode.
VITE_CLOUDFLARE_GATEWAY_URL=
VITE_CLOUDFLARE_GATEWAY_SCOPE=
